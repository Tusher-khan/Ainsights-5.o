# ---------------------------------------------------------------------------
# AInsight configuration. Copy to .env and edit. Never commit your real .env.
# ---------------------------------------------------------------------------

# --- language model ---------------------------------------------------------
# DEMO_MODE=true runs the full pipeline with the deterministic planner and no
# external API. Analytics, validation, charts and the UI all work offline.
DEMO_MODE=true

# Used when DEMO_MODE=false. One of: openai | anthropic | gemini | local
LLM_PROVIDER=openai
MODEL_NAME=

OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LOCAL_LLM_BASE_URL=http://localhost:11434/v1

LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=1200
LLM_TEMPERATURE=0.0

# --- storage ----------------------------------------------------------------
DATABASE_URL=sqlite:///database/analytics.db
# ANALYTICS_DATABASE_URL=sqlite:///database/analytics.db
CHROMA_PATH=data/processed/chroma
UPLOAD_DIR=data/uploads

# --- limits -----------------------------------------------------------------
MAX_FILE_SIZE_MB=50
MAX_QUERY_RETRIES=2
MAX_RESULT_ROWS=5000
QUERY_TIMEOUT_SECONDS=30
RAG_TOP_K=6
MEMORY_TURNS=8

# --- server -----------------------------------------------------------------
HOST=0.0.0.0
PORT=5000
DEBUG=false
# Leave this off unless you're actively editing code — see app.py for why it
# can make the server appear to "shut down" when you upload a file.
RELOADER=false
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production
